#!/bin/bash
# Eseguibile dell'app "Funding Report". Doppio click -> prepara l'ambiente,
# scarica i dati funding da Bybit, genera il report e lo apre nel browser.
# Nessuna finestra di terminale: l'avanzamento arriva come notifiche macOS,
# gli errori come finestrelle. Il log completo sta in funding/last-run.log.

set -u

HERE="$(cd "$(dirname "$0")" && pwd)"          # .../Funding Report.app/Contents/MacOS
ROOT="$(cd "$HERE/../../.." && pwd)"           # cartella che contiene l'app = progetto
LOG="$ROOT/funding/last-run.log"

mkdir -p "$ROOT/funding" 2>/dev/null
exec > "$LOG" 2>&1                              # tutto l'output tecnico va nel log
echo "== Funding Report: avvio $(date) =="
echo "ROOT=$ROOT"

notify()  { /usr/bin/osascript -e "display notification \"$1\" with title \"Funding Report\"" 2>/dev/null; }
alert()   { /usr/bin/osascript -e "display dialog \"$1\" with title \"Funding Report\" buttons {\"OK\"} default button 1 with icon caution" 2>/dev/null; }

cd "$ROOT" || { alert "Non trovo la cartella del progetto."; exit 1; }

# 1) Python presente?
if ! command -v python3 >/dev/null 2>&1; then
  alert "Manca Python 3 sul Mac. Apro la pagina per installarlo: scarica e installa, poi riapri Funding Report."
  open "https://www.python.org/downloads/macos/"
  exit 1
fi

# 2) Ambiente + librerie (la prima volta richiede 1-2 minuti)
notify "Preparo l'ambiente (prima volta: 1-2 min)..."
if [ ! -x "./.venv/bin/python" ]; then
  python3 -m venv .venv || { alert "Errore creando l'ambiente Python. Vedi funding/last-run.log"; exit 1; }
fi
./.venv/bin/python -m pip install -q --upgrade pip
./.venv/bin/pip install -q -r funding/requirements.txt || { alert "Errore installando le librerie. Vedi funding/last-run.log"; exit 1; }

# 3) Raccolta (exit!=0 per buchi/0 righe non e' fatale: il report va comunque aperto)
notify "Scarico i dati funding da Bybit... attendi qualche minuto."
./.venv/bin/python funding/collect.py
RC=$?
echo "collect.py exit code: $RC"

# 4) Apri il report
REPORT="$ROOT/funding/reports/verification-latest.html"
if [ -f "$REPORT" ]; then
  notify "Fatto! Apro il report."
  open "$REPORT"
else
  alert "Raccolta terminata ma non trovo il report. Vedi funding/last-run.log"
  exit 1
fi
echo "== fine $(date) =="
